<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: tokens and passwords must never travel unencrypted. User-installed CAs are not trusted. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
